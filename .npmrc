# The Mendix widget tooling resolves eslint, prettier, babel and rollup plugins
# from the workspace root, so they must be hoisted.
auto-install-peers=true
link-workspace-packages=true
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*rollup*
public-hoist-pattern[]=*jest*
public-hoist-pattern[]=big.js
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=mime
public-hoist-pattern[]=make-dir
