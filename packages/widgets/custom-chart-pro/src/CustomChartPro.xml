<?xml version="1.0" encoding="utf-8" ?>
<widget id="com.kendallchristy.widget.web.customchartpro.CustomChartPro" pluginWidget="true" offlineCapable="true" supportedPlatform="Web" xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Custom Chart Pro</name>
    <description>Any chart Apache ECharts can draw, such as sankey, treemap, sunburst, graph or map, from an ECharts option with Mendix data.</description>
    <studioProCategory>Charts</studioProCategory>
    <studioCategory>Charts</studioCategory>
    <helpUrl>https://github.com/kendallchristy/mendix-web-widgets/blob/main/docs/charts/custom-chart.md</helpUrl>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Option">
                <property key="optionJson" type="string" multiline="true" required="false">
                    <caption>Option JSON</caption>
                    <description>The ECharts option, as JSON: https://echarts.apache.org/en/option.html. Each data set is added to its dataset list by name. A string "$rows:Sales" becomes the Sales rows as objects, "$column:Sales.value" one field's values, "$tree:Sales" a tree from name, parent and value fields, and "$nodes:Sales" the names in its source and target fields.</description>
                </property>
                <property key="optionJsonExpression" type="expression" required="false">
                    <caption>Option JSON (dynamic)</caption>
                    <description>An option from an attribute or expression, merged over Option JSON.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
            <propertyGroup caption="Data">
                <property key="dataSets" type="object" isList="true" required="false">
                    <caption>Data sets</caption>
                    <description>Mendix data for the option. Each becomes an ECharts dataset named after it, with one row per object.</description>
                    <properties>
                        <propertyGroup caption="Data set">
                            <property key="name" type="string">
                                <caption>Name</caption>
                                <description>How the option refers to this data set, for example Sales. Letters, digits and underscores.</description>
                            </property>
                            <property key="dataSource" type="datasource" isList="true">
                                <caption>Data source</caption>
                                <description>One row per object.</description>
                            </property>
                            <property key="field1" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 1</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field1Name" type="string" required="false">
                                <caption>Field 1 name</caption>
                                <description>How the option refers to this field, for example name.</description>
                            </property>
                            <property key="field2" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 2</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field2Name" type="string" required="false">
                                <caption>Field 2 name</caption>
                                <description>How the option refers to this field, for example value.</description>
                            </property>
                            <property key="field3" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 3</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field3Name" type="string" required="false">
                                <caption>Field 3 name</caption>
                                <description>How the option refers to this field, for example source.</description>
                            </property>
                            <property key="field4" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 4</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field4Name" type="string" required="false">
                                <caption>Field 4 name</caption>
                                <description>How the option refers to this field, for example target.</description>
                            </property>
                            <property key="field5" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 5</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field5Name" type="string" required="false">
                                <caption>Field 5 name</caption>
                                <description>How the option refers to this field, for example parent.</description>
                            </property>
                            <property key="field6" type="attribute" dataSource="dataSource" required="false">
                                <caption>Field 6</caption>
                                <description />
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="DateTime" />
                                </attributeTypes>
                            </property>
                            <property key="field6Name" type="string" required="false">
                                <caption>Field 6 name</caption>
                                <description>How the option refers to this field, for example date.</description>
                            </property>
                            <property key="onClick" type="action" dataSource="dataSource" required="false">
                                <caption>On click</caption>
                                <description>Runs with the clicked row's object, for series drawn from this data set's rows.</description>
                            </property>
                        </propertyGroup>
                    </properties>
                </property>
            </propertyGroup>
            <propertyGroup caption="Map">
                <property key="mapName" type="string" required="false">
                    <caption>Map name</caption>
                    <description>For map series and geo: the name the option uses in "map", for example world.</description>
                </property>
                <property key="mapUrl" type="string" required="false">
                    <caption>Map GeoJSON URL</caption>
                    <description>Where the map's GeoJSON is, for example a file in your theme folder: /resources/maps/world.json.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Title">
                <property key="title" type="textTemplate" required="false">
                    <caption>Title</caption>
                    <description>Leave empty when the page already has a heading.</description>
                </property>
                <property key="subtitle" type="textTemplate" required="false">
                    <caption>Subtitle</caption>
                    <description />
                </property>
                <property key="titleAlign" type="enumeration" defaultValue="left">
                    <caption>Title position</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="left">Top left</enumerationValue>
                        <enumerationValue key="center">Top centre</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="emptyMessage" type="textTemplate" required="false">
                    <caption>No data message</caption>
                    <description>Shown when every data set is empty.</description>
                    <translations>
                        <translation lang="en_US">No data</translation>
                    </translations>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Chart style">
            <propertyGroup caption="Theme">
                <property key="theme" type="enumeration" defaultValue="hyper">
                    <caption>Theme</caption>
                    <description>Hyper follows the app: set --hc-mode: dark under your dark-mode class.</description>
                    <enumerationValues>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperLight">Hyper light</enumerationValue>
                        <enumerationValue key="hyperDark">Hyper dark</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="palette" type="enumeration" defaultValue="theme">
                    <caption>Palette</caption>
                    <description>Theme colours come from the theme, or from --hc-color-1 to --hc-color-8 in your theme SCSS.</description>
                    <enumerationValues>
                        <enumerationValue key="theme">Theme colours</enumerationValue>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperHighContrast">Hyper high-contrast</enumerationValue>
                        <enumerationValue key="monochrome">Monochrome</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="customPalette" type="string" required="false">
                    <caption>Custom colours</caption>
                    <description>Comma-separated, in order, for example #8038D0, #F87800, #0860F8.</description>
                </property>
                <property key="background" type="enumeration" defaultValue="transparent">
                    <caption>Background</caption>
                    <description>Transparent lets the chart sit on whatever container holds it.</description>
                    <enumerationValues>
                        <enumerationValue key="transparent">Transparent</enumerationValue>
                        <enumerationValue key="surface">Theme surface</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="figuresFont" type="enumeration" defaultValue="mono">
                    <caption>Figures font</caption>
                    <description>Font for numbers on axis labels.</description>
                    <enumerationValues>
                        <enumerationValue key="mono">Monospaced</enumerationValue>
                        <enumerationValue key="text">Same as text</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Size and motion">
                <property key="heightUnit" type="enumeration" defaultValue="pixels">
                    <caption>Height unit</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="pixels">Pixels</enumerationValue>
                        <enumerationValue key="percentageOfWidth">Percentage of width</enumerationValue>
                        <enumerationValue key="fill">Fill the container</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="height" type="integer" defaultValue="240">
                    <caption>Height</caption>
                    <description />
                </property>
                <property key="animation" type="boolean" defaultValue="true">
                    <caption>Animation</caption>
                    <description />
                </property>
                <property key="animationDuration" type="integer" defaultValue="600">
                    <caption>Animation duration</caption>
                    <description>In milliseconds.</description>
                </property>
                <property key="renderer" type="enumeration" defaultValue="canvas">
                    <caption>Renderer</caption>
                    <description>Canvas is fastest for large data. SVG is sharper when printed.</description>
                    <enumerationValues>
                        <enumerationValue key="canvas">Canvas</enumerationValue>
                        <enumerationValue key="svg">SVG</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Advanced">
            <propertyGroup caption="Custom theme">
                <property key="themeJson" type="string" multiline="true" required="false">
                    <caption>Theme JSON</caption>
                    <description>Used when Theme is Custom. Build one at https://echarts.apache.org/en/theme-builder.html: 1. Import hyper-light.theme-builder.json from the styling guide (Help). 2. Adjust it. 3. Download the JSON version and paste it here.</description>
                </property>
                <property key="themeJsonExpression" type="expression" required="false">
                    <caption>Theme JSON (dynamic)</caption>
                    <description>A theme from an attribute or expression, merged over Theme JSON. Lets each customer or user have their own.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
        </propertyGroup>
    </properties>
</widget>
