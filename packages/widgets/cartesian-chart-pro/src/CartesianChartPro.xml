<?xml version="1.0" encoding="utf-8" ?>
<widget id="com.kendallchristy.widget.web.cartesianchartpro.CartesianChartPro" pluginWidget="true" offlineCapable="true" supportedPlatform="Web" xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Cartesian Chart Pro</name>
    <description>Line, area, bar, column, scatter and bubble charts, alone or combined.</description>
    <studioProCategory>Charts</studioProCategory>
    <studioCategory>Charts</studioCategory>
    <helpUrl>https://github.com/kendallchristy/mendix-web-widgets/blob/main/docs/charts/styling.md</helpUrl>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Series">
                <property key="series" type="object" isList="true">
                    <caption>Series</caption>
                    <description>One entry per line, area, set of bars or set of points. Later series are drawn on top.</description>
                    <properties>
                        <propertyGroup caption="Data">
                            <property key="dataSource" type="datasource" isList="true">
                                <caption>Data source</caption>
                                <description>One object per data point.</description>
                            </property>
                            <property key="seriesType" type="enumeration" defaultValue="line">
                                <caption>Type</caption>
                                <description />
                                <enumerationValues>
                                    <enumerationValue key="line">Line</enumerationValue>
                                    <enumerationValue key="area">Area</enumerationValue>
                                    <enumerationValue key="bar">Bar</enumerationValue>
                                    <enumerationValue key="scatter">Scatter</enumerationValue>
                                    <enumerationValue key="bubble">Bubble</enumerationValue>
                                </enumerationValues>
                            </property>
                            <property key="seriesName" type="textTemplate" required="false">
                                <caption>Name</caption>
                                <description>Shown in the legend and tooltip. With Group by, each group is named after its value instead.</description>
                            </property>
                            <property key="xAttribute" type="attribute" dataSource="dataSource">
                                <caption>X value</caption>
                                <description>Dates give a time axis, numbers a number axis, anything else a category axis.</description>
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="DateTime" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                </attributeTypes>
                            </property>
                            <property key="yAttribute" type="attribute" dataSource="dataSource" required="false">
                                <caption>Y value</caption>
                                <description>Not needed when Aggregation is Count.</description>
                                <attributeTypes>
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                </attributeTypes>
                            </property>
                            <property key="sizeAttribute" type="attribute" dataSource="dataSource" required="false">
                                <caption>Bubble size</caption>
                                <description>Bubble area grows with this value.</description>
                                <attributeTypes>
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                    <attributeType name="Decimal" />
                                </attributeTypes>
                            </property>
                            <property key="groupByAttribute" type="attribute" dataSource="dataSource" required="false">
                                <caption>Group by</caption>
                                <description>Splits the data source into one series per value, for example one line per region.</description>
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                </attributeTypes>
                            </property>
                            <property key="aggregation" type="enumeration" defaultValue="none">
                                <caption>Aggregation</caption>
                                <description>How points with the same X value combine. Date drilldown sums when this is None.</description>
                                <enumerationValues>
                                    <enumerationValue key="none">None</enumerationValue>
                                    <enumerationValue key="sum">Sum</enumerationValue>
                                    <enumerationValue key="avg">Average</enumerationValue>
                                    <enumerationValue key="count">Count</enumerationValue>
                                    <enumerationValue key="min">Minimum</enumerationValue>
                                    <enumerationValue key="max">Maximum</enumerationValue>
                                </enumerationValues>
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Interaction">
                            <property key="tooltipText" type="textTemplate" dataSource="dataSource" required="false">
                                <caption>Tooltip text</caption>
                                <description>Replaces this series' row in the tooltip. Leave empty for the name and value.</description>
                            </property>
                            <property key="onClick" type="action" dataSource="dataSource" required="false">
                                <caption>On click</caption>
                                <description>Runs with the clicked object. For an aggregated point, the first object behind it. With drilldown, runs at the last level.</description>
                            </property>
                            <property key="drillAttribute1" type="attribute" dataSource="dataSource" required="false">
                                <caption>Drilldown level 2</caption>
                                <description>Category drilldown: clicking an X value regroups its objects by this attribute.</description>
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                </attributeTypes>
                            </property>
                            <property key="drillAttribute2" type="attribute" dataSource="dataSource" required="false">
                                <caption>Drilldown level 3</caption>
                                <description>Category drilldown: the level below level 2.</description>
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                </attributeTypes>
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Appearance">
                            <property key="color" type="string" required="false">
                                <caption>Colour</caption>
                                <description>Overrides the palette for this series, for example #8038D0.</description>
                            </property>
                            <property key="stack" type="string" required="false">
                                <caption>Stack</caption>
                                <description>Series with the same stack name are stacked on each other.</description>
                            </property>
                            <property key="yAxisSide" type="enumeration" defaultValue="left">
                                <caption>Y axis</caption>
                                <description>Put a series with a different scale on its own axis on the right.</description>
                                <enumerationValues>
                                    <enumerationValue key="left">Left</enumerationValue>
                                    <enumerationValue key="right">Right</enumerationValue>
                                </enumerationValues>
                            </property>
                        </propertyGroup>
                    </properties>
                </property>
            </propertyGroup>
            <propertyGroup caption="Title">
                <property key="title" type="textTemplate" required="false">
                    <caption>Title</caption>
                    <description>Leave empty when the page already has a heading.</description>
                </property>
                <property key="subtitle" type="textTemplate" required="false">
                    <caption>Subtitle</caption>
                    <description />
                </property>
                <property key="titleAlign" type="enumeration" defaultValue="left">
                    <caption>Title position</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="left">Top left</enumerationValue>
                        <enumerationValue key="center">Top centre</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="emptyMessage" type="textTemplate" required="false">
                    <caption>No data message</caption>
                    <description />
                    <translations>
                        <translation lang="en_US">No data</translation>
                    </translations>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Axes">
            <propertyGroup caption="Layout">
                <property key="orientation" type="enumeration" defaultValue="vertical">
                    <caption>Orientation</caption>
                    <description>Horizontal puts the X values down the left side, for horizontal bars.</description>
                    <enumerationValues>
                        <enumerationValue key="vertical">Vertical</enumerationValue>
                        <enumerationValue key="horizontal">Horizontal</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="showXAxis" type="boolean" defaultValue="true">
                    <caption>Show X axis labels</caption>
                    <description />
                </property>
                <property key="showYAxis" type="boolean" defaultValue="false">
                    <caption>Show Y axis labels</caption>
                    <description>The Hyper look hides them and relies on tooltips and value labels.</description>
                </property>
                <property key="xAxisTitle" type="textTemplate" required="false">
                    <caption>X axis title</caption>
                    <description />
                </property>
                <property key="yAxisTitle" type="textTemplate" required="false">
                    <caption>Y axis title</caption>
                    <description />
                </property>
            </propertyGroup>
            <propertyGroup caption="Y axis range">
                <property key="yAxisMin" type="expression" required="false">
                    <caption>Minimum</caption>
                    <description>Leave empty to fit the data.</description>
                    <returnType type="Decimal" />
                </property>
                <property key="yAxisMax" type="expression" required="false">
                    <caption>Maximum</caption>
                    <description>Leave empty to fit the data.</description>
                    <returnType type="Decimal" />
                </property>
                <property key="yAxisScale" type="enumeration" defaultValue="linear">
                    <caption>Scale</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="linear">Linear</enumerationValue>
                        <enumerationValue key="log">Logarithmic</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Number format">
                <property key="decimals" type="integer" defaultValue="-1">
                    <caption>Decimals</caption>
                    <description>-1 shows up to two decimals, only when needed.</description>
                </property>
                <property key="prefix" type="string" required="false">
                    <caption>Prefix</caption>
                    <description>For example $.</description>
                </property>
                <property key="suffix" type="string" required="false">
                    <caption>Suffix</caption>
                    <description>For example % or  kg.</description>
                </property>
                <property key="thousandsSeparator" type="boolean" defaultValue="true">
                    <caption>Thousands separator</caption>
                    <description />
                </property>
                <property key="compactNumbers" type="boolean" defaultValue="false">
                    <caption>Compact numbers</caption>
                    <description>1.2K instead of 1,200.</description>
                </property>
                <property key="xDateFormat" type="string" required="false">
                    <caption>X axis date format</caption>
                    <description>ECharts template, for example {MMM} {d} or {yyyy}-{MM}-{dd}. Empty picks one that fits the range.</description>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Interaction">
            <propertyGroup caption="Drilldown">
                <property key="drilldown" type="enumeration" defaultValue="none">
                    <caption>Drilldown</caption>
                    <description>Date: click a year to see its quarters, and so on. Category: click an X value to regroup by each series' Drilldown level attributes.</description>
                    <enumerationValues>
                        <enumerationValue key="none">None</enumerationValue>
                        <enumerationValue key="date">Date</enumerationValue>
                        <enumerationValue key="category">Category</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="drillDateFrom" type="enumeration" defaultValue="year">
                    <caption>Start at</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="year">Year</enumerationValue>
                        <enumerationValue key="quarter">Quarter</enumerationValue>
                        <enumerationValue key="month">Month</enumerationValue>
                        <enumerationValue key="week">Week</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="drillDateTo" type="enumeration" defaultValue="day">
                    <caption>Deepest level</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="quarter">Quarter</enumerationValue>
                        <enumerationValue key="month">Month</enumerationValue>
                        <enumerationValue key="week">Week</enumerationValue>
                        <enumerationValue key="day">Day</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="drillTopLabel" type="textTemplate" required="false">
                    <caption>Top level label</caption>
                    <description>First item in the breadcrumb.</description>
                    <translations>
                        <translation lang="en_US">All</translation>
                    </translations>
                </property>
            </propertyGroup>
            <propertyGroup caption="Zoom">
                <property key="zoom" type="enumeration" defaultValue="none">
                    <caption>Zoom</caption>
                    <description>For long time series.</description>
                    <enumerationValues>
                        <enumerationValue key="none">None</enumerationValue>
                        <enumerationValue key="slider">Slider</enumerationValue>
                        <enumerationValue key="inside">Drag and scroll</enumerationValue>
                        <enumerationValue key="both">Both</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Chart style">
            <propertyGroup caption="Theme">
                <property key="theme" type="enumeration" defaultValue="hyper">
                    <caption>Theme</caption>
                    <description>Hyper follows the app: set --hc-mode: dark under your dark-mode class.</description>
                    <enumerationValues>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperLight">Hyper light</enumerationValue>
                        <enumerationValue key="hyperDark">Hyper dark</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="palette" type="enumeration" defaultValue="theme">
                    <caption>Palette</caption>
                    <description>Theme colours come from the theme, or from --hc-color-1 to --hc-color-8 in your theme SCSS.</description>
                    <enumerationValues>
                        <enumerationValue key="theme">Theme colours</enumerationValue>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperHighContrast">Hyper high-contrast</enumerationValue>
                        <enumerationValue key="monochrome">Monochrome</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="customPalette" type="string" required="false">
                    <caption>Custom colours</caption>
                    <description>Comma-separated, in series order, for example #8038D0, #F87800, #0860F8.</description>
                </property>
                <property key="background" type="enumeration" defaultValue="transparent">
                    <caption>Background</caption>
                    <description>Transparent lets the chart sit on whatever container holds it.</description>
                    <enumerationValues>
                        <enumerationValue key="transparent">Transparent</enumerationValue>
                        <enumerationValue key="surface">Theme surface</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="figuresFont" type="enumeration" defaultValue="mono">
                    <caption>Figures font</caption>
                    <description>Font for numbers on axes, labels and tooltips.</description>
                    <enumerationValues>
                        <enumerationValue key="mono">Monospaced</enumerationValue>
                        <enumerationValue key="text">Same as text</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Lines and areas">
                <property key="lineCurve" type="enumeration" defaultValue="smooth">
                    <caption>Line curve</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="smooth">Smooth</enumerationValue>
                        <enumerationValue key="straight">Straight</enumerationValue>
                        <enumerationValue key="step">Step</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="lineWidth" type="decimal" defaultValue="2.5">
                    <caption>Line width</caption>
                    <description>In pixels.</description>
                </property>
                <property key="areaFill" type="enumeration" defaultValue="gradient">
                    <caption>Area fill</caption>
                    <description>For Area series.</description>
                    <enumerationValues>
                        <enumerationValue key="gradient">Gradient</enumerationValue>
                        <enumerationValue key="solid">Solid</enumerationValue>
                        <enumerationValue key="none">None</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="glow" type="enumeration" defaultValue="soft">
                    <caption>Glow</caption>
                    <description>A soft coloured shadow under lines and bars.</description>
                    <enumerationValues>
                        <enumerationValue key="soft">Soft</enumerationValue>
                        <enumerationValue key="off">Off</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="markers" type="enumeration" defaultValue="highlighted">
                    <caption>Point markers</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="highlighted">Highlighted points only</enumerationValue>
                        <enumerationValue key="hover">On hover</enumerationValue>
                        <enumerationValue key="always">Always</enumerationValue>
                        <enumerationValue key="never">Never</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Bars">
                <property key="barStyle" type="enumeration" defaultValue="solid">
                    <caption>Bar style</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="solid">Solid</enumerationValue>
                        <enumerationValue key="striped">Striped</enumerationValue>
                        <enumerationValue key="dots">Dots</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="barRadius" type="integer" defaultValue="4">
                    <caption>Corner radius</caption>
                    <description>In pixels, on the end of each bar.</description>
                </property>
                <property key="barWidth" type="integer" defaultValue="60">
                    <caption>Bar width</caption>
                    <description>Percent of the space each X value gets.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Highlight and labels">
                <property key="highlightFrom" type="expression" required="false">
                    <caption>Highlight from</caption>
                    <description>An X value. Points from here to Highlight to keep their colour; the rest turn grey. Dates as ISO text, for example '2026-03-01'.</description>
                    <returnType type="String" />
                </property>
                <property key="highlightTo" type="expression" required="false">
                    <caption>Highlight to</caption>
                    <description />
                    <returnType type="String" />
                </property>
                <property key="valueLabels" type="enumeration" defaultValue="darkPill">
                    <caption>Value labels</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="darkPill">Dark pill</enumerationValue>
                        <enumerationValue key="lightPill">Light pill</enumerationValue>
                        <enumerationValue key="plain">Plain</enumerationValue>
                        <enumerationValue key="off">Off</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="valueLabelPoints" type="enumeration" defaultValue="highlightEnds">
                    <caption>Label which points</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="highlightEnds">Ends of the highlight</enumerationValue>
                        <enumerationValue key="last">Last point</enumerationValue>
                        <enumerationValue key="all">All points</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Grid, legend and tooltip">
                <property key="gridlines" type="enumeration" defaultValue="vertical">
                    <caption>Gridlines</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="vertical">Vertical</enumerationValue>
                        <enumerationValue key="horizontal">Horizontal</enumerationValue>
                        <enumerationValue key="both">Both</enumerationValue>
                        <enumerationValue key="none">None</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="legend" type="enumeration" defaultValue="auto">
                    <caption>Legend</caption>
                    <description>Automatic hides it for a single series.</description>
                    <enumerationValues>
                        <enumerationValue key="auto">Automatic</enumerationValue>
                        <enumerationValue key="top">Top</enumerationValue>
                        <enumerationValue key="bottom">Bottom</enumerationValue>
                        <enumerationValue key="right">Right</enumerationValue>
                        <enumerationValue key="hidden">Hidden</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="tooltip" type="enumeration" defaultValue="card">
                    <caption>Tooltip</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="card">Card</enumerationValue>
                        <enumerationValue key="pill">Pill</enumerationValue>
                        <enumerationValue key="off">Off</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="hoverGuide" type="enumeration" defaultValue="line">
                    <caption>Hover guide</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="line">Line</enumerationValue>
                        <enumerationValue key="band">Shaded band</enumerationValue>
                        <enumerationValue key="none">None</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Size and motion">
                <property key="heightUnit" type="enumeration" defaultValue="pixels">
                    <caption>Height unit</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="pixels">Pixels</enumerationValue>
                        <enumerationValue key="percentageOfWidth">Percentage of width</enumerationValue>
                        <enumerationValue key="fill">Fill the container</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="height" type="integer" defaultValue="240">
                    <caption>Height</caption>
                    <description />
                </property>
                <property key="animation" type="boolean" defaultValue="true">
                    <caption>Animation</caption>
                    <description />
                </property>
                <property key="animationDuration" type="integer" defaultValue="600">
                    <caption>Animation duration</caption>
                    <description>In milliseconds.</description>
                </property>
                <property key="renderer" type="enumeration" defaultValue="canvas">
                    <caption>Renderer</caption>
                    <description>Canvas is fastest for large data. SVG is sharper when printed.</description>
                    <enumerationValues>
                        <enumerationValue key="canvas">Canvas</enumerationValue>
                        <enumerationValue key="svg">SVG</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Advanced">
            <propertyGroup caption="Custom theme">
                <property key="themeJson" type="string" multiline="true" required="false">
                    <caption>Theme JSON</caption>
                    <description>Used when Theme is Custom. Build one at https://echarts.apache.org/en/theme-builder.html: 1. Import hyper-light.theme-builder.json from the styling guide (Help). 2. Adjust it. 3. Download the JSON version and paste it here.</description>
                </property>
                <property key="themeJsonExpression" type="expression" required="false">
                    <caption>Theme JSON (dynamic)</caption>
                    <description>A theme from an attribute or expression, merged over Theme JSON. Lets each customer or user have their own.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
            <propertyGroup caption="Option override">
                <property key="optionOverride" type="string" multiline="true" required="false">
                    <caption>Option override</caption>
                    <description>ECharts option JSON merged over everything else, last. Anything ECharts supports: https://echarts.apache.org/en/option.html</description>
                </property>
                <property key="optionOverrideExpression" type="expression" required="false">
                    <caption>Option override (dynamic)</caption>
                    <description>Merged after Option override.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
        </propertyGroup>
    </properties>
</widget>
