<?xml version="1.0" encoding="utf-8" ?>
<widget id="com.kendallchristy.widget.web.datagridpro.DataGridPro" pluginWidget="true" offlineCapable="true" supportedPlatform="Web" xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Data Grid Pro</name>
    <description>A fast, high-density data grid with true row virtualization.</description>
    <studioProCategory>Data containers</studioProCategory>
    <studioCategory>Data Containers</studioCategory>
    <helpUrl>https://github.com/kendallchristy/mendix-web-widgets/blob/main/packages/widgets/data-grid-pro/README.md</helpUrl>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Data">
                <property key="datasource" type="datasource" isList="true">
                    <caption>Data source</caption>
                    <description />
                </property>
                <property key="refreshInterval" type="integer" defaultValue="0">
                    <caption>Refresh time (seconds)</caption>
                    <description>Reload the data on this interval. 0 turns it off.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Columns">
                <property key="columns" type="object" isList="true">
                    <caption>Columns</caption>
                    <description />
                    <properties>
                        <propertyGroup caption="General">
                            <property key="header" type="textTemplate" required="false">
                                <caption>Header</caption>
                                <description />
                            </property>
                            <property key="showContentAs" type="enumeration" defaultValue="attribute">
                                <caption>Show</caption>
                                <description>Related objects shows many objects over an association as pills, loaded in one request per page of rows.</description>
                                <enumerationValues>
                                    <enumerationValue key="attribute">Attribute</enumerationValue>
                                    <enumerationValue key="dynamicText">Dynamic text</enumerationValue>
                                    <enumerationValue key="customContent">Custom content</enumerationValue>
                                    <enumerationValue key="related">Related objects</enumerationValue>
                                </enumerationValues>
                            </property>
                            <property key="attribute" type="attribute" dataSource="../datasource" required="false">
                                <caption>Attribute</caption>
                                <description>Needed to sort the column. An attribute over a reference set shows each value as a pill.</description>
                                <attributeTypes>
                                    <attributeType name="String" />
                                    <attributeType name="AutoNumber" />
                                    <attributeType name="Boolean" />
                                    <attributeType name="DateTime" />
                                    <attributeType name="Decimal" />
                                    <attributeType name="Enum" />
                                    <attributeType name="Integer" />
                                    <attributeType name="Long" />
                                </attributeTypes>
                                <associationTypes>
                                    <associationType name="Reference" />
                                    <associationType name="ReferenceSet" />
                                </associationTypes>
                            </property>
                            <property key="dynamicText" type="textTemplate" dataSource="../datasource" required="false">
                                <caption>Dynamic text</caption>
                                <description />
                            </property>
                            <property key="content" type="widgets" dataSource="../datasource" required="false">
                                <caption>Custom content</caption>
                                <description />
                            </property>
                            <property key="visible" type="expression" defaultValue="true">
                                <caption>Visible</caption>
                                <description />
                                <returnType type="Boolean" />
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Cell style">
                            <property key="cellStyle" type="enumeration" defaultValue="text">
                                <caption>Display as</caption>
                                <description />
                                <enumerationValues>
                                    <enumerationValue key="text">Text</enumerationValue>
                                    <enumerationValue key="badge">Badge</enumerationValue>
                                    <enumerationValue key="progress">Progress bar</enumerationValue>
                                </enumerationValues>
                            </property>
                            <property key="badgeColor" type="expression" dataSource="../datasource" required="false">
                                <caption>Badge color</caption>
                                <description>One of: gray, blue, green, yellow, orange, red, purple. Leave empty to pick a color from the value.</description>
                                <returnType type="String" />
                            </property>
                            <property key="progressMax" type="integer" defaultValue="100">
                                <caption>Progress maximum</caption>
                                <description>The value that fills the bar.</description>
                            </property>
                            <property key="expandedText" type="textTemplate" dataSource="../datasource" required="false">
                                <caption>Hover detail</caption>
                                <description>Extra text shown in the cell while the pointer is over the column, for example an absolute count next to a percentage.</description>
                            </property>
                            <property key="expandedWidth" type="integer" defaultValue="0">
                                <caption>Hover width (px)</caption>
                                <description>The column widens to at least this width while the pointer is over it. 0 turns it off.</description>
                            </property>
                            <property key="alignment" type="enumeration" defaultValue="left">
                                <caption>Alignment</caption>
                                <description />
                                <enumerationValues>
                                    <enumerationValue key="left">Left</enumerationValue>
                                    <enumerationValue key="center">Center</enumerationValue>
                                    <enumerationValue key="right">Right</enumerationValue>
                                </enumerationValues>
                            </property>
                            <property key="columnClass" type="expression" dataSource="../datasource" required="false">
                                <caption>Cell class</caption>
                                <description>CSS class added to each cell in this column.</description>
                                <returnType type="String" />
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Related objects">
                            <property key="relatedSource" type="datasource" isList="true" required="false">
                                <caption>Related data source</caption>
                                <description>The objects to show, for example order lines. Use this when the related entity owns the association to the row entity.</description>
                            </property>
                            <property key="relatedParent" type="association" dataSource="relatedSource" selectableObjects="../datasource" required="false">
                                <caption>Association to row</caption>
                                <description>The association from the related object to the grid's row object.</description>
                                <associationTypes>
                                    <associationType name="Reference" />
                                    <associationType name="ReferenceSet" />
                                </associationTypes>
                            </property>
                            <property key="relatedCaption" type="textTemplate" dataSource="relatedSource" required="false">
                                <caption>Caption</caption>
                                <description />
                            </property>
                            <property key="relatedColor" type="expression" dataSource="relatedSource" required="false">
                                <caption>Color</caption>
                                <description>One of: gray, blue, green, yellow, orange, red, purple. Leave empty to pick a color from the caption.</description>
                                <returnType type="String" />
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Capabilities">
                            <property key="sortable" type="boolean" defaultValue="true">
                                <caption>Can sort</caption>
                                <description>Needs an attribute.</description>
                            </property>
                            <property key="resizable" type="boolean" defaultValue="true">
                                <caption>Can resize</caption>
                                <description />
                            </property>
                            <property key="hidable" type="enumeration" defaultValue="yes">
                                <caption>Can hide</caption>
                                <description />
                                <enumerationValues>
                                    <enumerationValue key="yes">Yes</enumerationValue>
                                    <enumerationValue key="hidden">Yes, hidden by default</enumerationValue>
                                    <enumerationValue key="no">No</enumerationValue>
                                </enumerationValues>
                            </property>
                        </propertyGroup>
                        <propertyGroup caption="Width">
                            <property key="widthMode" type="enumeration" defaultValue="fill">
                                <caption>Width</caption>
                                <description />
                                <enumerationValues>
                                    <enumerationValue key="fill">Share remaining space</enumerationValue>
                                    <enumerationValue key="fixed">Fixed</enumerationValue>
                                </enumerationValues>
                            </property>
                            <property key="fillWeight" type="integer" defaultValue="1">
                                <caption>Share</caption>
                                <description>How much of the remaining space this column takes, relative to other columns.</description>
                            </property>
                            <property key="fixedWidth" type="integer" defaultValue="120">
                                <caption>Fixed width (px)</caption>
                                <description />
                            </property>
                            <property key="minWidth" type="integer" defaultValue="80">
                                <caption>Minimum width (px)</caption>
                                <description />
                            </property>
                        </propertyGroup>
                    </properties>
                </property>
                <property key="pinFirstColumn" type="boolean" defaultValue="true">
                    <caption>Pin first column</caption>
                    <description>Keep the first column visible when scrolling sideways.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Rows">
                <property key="density" type="enumeration" defaultValue="compact">
                    <caption>Density</caption>
                    <description>Row height: compact 32 px, default 40 px, comfortable 48 px.</description>
                    <enumerationValues>
                        <enumerationValue key="compact">Compact</enumerationValue>
                        <enumerationValue key="default">Default</enumerationValue>
                        <enumerationValue key="comfortable">Comfortable</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="stripes" type="boolean" defaultValue="false">
                    <caption>Striped rows</caption>
                    <description />
                </property>
                <property key="rowClass" type="expression" dataSource="datasource" required="false">
                    <caption>Row class</caption>
                    <description />
                    <returnType type="String" />
                </property>
                <property key="onClick" type="action" dataSource="datasource" required="false">
                    <caption>On click action</caption>
                    <description />
                </property>
                <property key="onClickTrigger" type="enumeration" defaultValue="single">
                    <caption>On click trigger</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="single">Single click</enumerationValue>
                        <enumerationValue key="double">Double click</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="detailContent" type="widgets" dataSource="datasource" required="false">
                    <caption>Row details</caption>
                    <description>Widgets shown below a row when it is expanded. Leave empty to turn off expandable rows.</description>
                </property>
                <property key="expandTrigger" type="enumeration" defaultValue="chevron">
                    <caption>Expand on</caption>
                    <description>Row click opens and closes the details when a row is clicked anywhere outside buttons, links and inputs.</description>
                    <enumerationValues>
                        <enumerationValue key="chevron">Chevron only</enumerationValue>
                        <enumerationValue key="row">Row click</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="singleExpand" type="boolean" defaultValue="false">
                    <caption>One open at a time</caption>
                    <description>Opening a row closes the row that was open before, like an accordion.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Selection">
                <property key="itemSelection" type="selection" dataSource="datasource" onChange="onSelectionChange">
                    <caption>Selection</caption>
                    <description>Multi selection adds a checkbox column. Single selection selects a row when it is clicked.</description>
                    <selectionTypes>
                        <selectionType name="None" />
                        <selectionType name="Single" />
                        <selectionType name="Multi" />
                    </selectionTypes>
                </property>
                <property key="onSelectionChange" type="action" required="false">
                    <caption>On selection change</caption>
                    <description />
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Toolbar">
            <propertyGroup caption="Toolbar">
                <property key="title" type="textTemplate" required="false">
                    <caption>Title</caption>
                    <description />
                </property>
                <property key="showCount" type="boolean" defaultValue="true">
                    <caption>Show row count</caption>
                    <description>Shows the total number of rows next to the title.</description>
                </property>
                <property key="toolbarContent" type="widgets" required="false">
                    <caption>Toolbar widgets</caption>
                    <description>Filters and buttons shown above the grid.</description>
                </property>
                <property key="bulkActions" type="widgets" required="false">
                    <caption>Bulk actions</caption>
                    <description>Widgets shown in place of the toolbar while rows are selected.</description>
                </property>
                <property key="showColumnMenu" type="boolean" defaultValue="true">
                    <caption>Column menu</caption>
                    <description>A button that lets users show and hide columns.</description>
                </property>
                <property key="showDensityToggle" type="boolean" defaultValue="false">
                    <caption>Density toggle</caption>
                    <description>A button that lets users change the row height.</description>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Loading">
            <propertyGroup caption="Pagination">
                <property key="pagination" type="enumeration" defaultValue="virtualScrolling">
                    <caption>Pagination</caption>
                    <description>Virtual scrolling loads rows as the user scrolls and only draws the rows on screen.</description>
                    <enumerationValues>
                        <enumerationValue key="virtualScrolling">Virtual scrolling</enumerationValue>
                        <enumerationValue key="pages">Pages</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="pageSize" type="integer" defaultValue="50">
                    <caption>Page size</caption>
                    <description>Rows per page, or per request when virtual scrolling.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Size">
                <property key="heightMode" type="enumeration" defaultValue="fixed">
                    <caption>Height</caption>
                    <description>Fill takes the height of the parent container, so the parent needs a height of its own. Without one, the grid is as tall as the window.</description>
                    <enumerationValues>
                        <enumerationValue key="fixed">Fixed</enumerationValue>
                        <enumerationValue key="fill">Fill the parent container</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="height" type="integer" defaultValue="600">
                    <caption>Height (px)</caption>
                    <description />
                </property>
            </propertyGroup>
            <propertyGroup caption="Empty state">
                <property key="emptyPlaceholder" type="widgets" required="false">
                    <caption>Empty message</caption>
                    <description>Widgets shown when there are no rows. Leave empty for the default message.</description>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Personalization">
            <propertyGroup caption="Personalization">
                <property key="configurationStorage" type="enumeration" defaultValue="browser">
                    <caption>Store user settings</caption>
                    <description>Column widths, hidden columns, sort order and density.</description>
                    <enumerationValues>
                        <enumerationValue key="none">Don't store</enumerationValue>
                        <enumerationValue key="browser">In the browser</enumerationValue>
                        <enumerationValue key="attribute">In an attribute</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="configurationAttribute" type="attribute" required="false">
                    <caption>Settings attribute</caption>
                    <description>An unlimited String attribute that stores the settings.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
            </propertyGroup>
        </propertyGroup>
    </properties>
</widget>
