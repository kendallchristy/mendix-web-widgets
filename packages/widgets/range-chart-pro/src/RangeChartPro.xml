<?xml version="1.0" encoding="utf-8" ?>
<widget id="com.kendallchristy.widget.web.rangechartpro.RangeChartPro" pluginWidget="true" offlineCapable="true" supportedPlatform="Web" xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Range Chart Pro</name>
    <description>Floating bars or dumbbells from a low to a high value per category, such as price ranges or schedules.</description>
    <studioProCategory>Charts</studioProCategory>
    <studioCategory>Charts</studioCategory>
    <helpUrl>https://github.com/kendallchristy/mendix-web-widgets/blob/main/docs/charts/styling.md</helpUrl>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Data">
                <property key="dataSource" type="datasource" isList="true">
                    <caption>Data source</caption>
                    <description>One object per range.</description>
                </property>
                <property key="categoryAttribute" type="attribute" dataSource="dataSource">
                    <caption>Category</caption>
                    <description>Names each range. Ranges with the same category share a row.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                        <attributeType name="Enum" />
                        <attributeType name="Boolean" />
                        <attributeType name="AutoNumber" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="lowAttribute" type="attribute" dataSource="dataSource">
                    <caption>From</caption>
                    <description>Where the range starts. Dates give a time axis.</description>
                    <attributeTypes>
                        <attributeType name="AutoNumber" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                        <attributeType name="Decimal" />
                        <attributeType name="DateTime" />
                    </attributeTypes>
                </property>
                <property key="highAttribute" type="attribute" dataSource="dataSource">
                    <caption>To</caption>
                    <description>Where the range ends. Use the same type as From.</description>
                    <attributeTypes>
                        <attributeType name="AutoNumber" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                        <attributeType name="Decimal" />
                        <attributeType name="DateTime" />
                    </attributeTypes>
                </property>
                <property key="groupByAttribute" type="attribute" dataSource="dataSource" required="false">
                    <caption>Group by</caption>
                    <description>Optional. Splits the ranges into series, for example planned and actual.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                        <attributeType name="Enum" />
                        <attributeType name="Boolean" />
                        <attributeType name="AutoNumber" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="sortOrder" type="enumeration" defaultValue="data">
                    <caption>Order</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="data">Data source order</enumerationValue>
                        <enumerationValue key="name">By name</enumerationValue>
                        <enumerationValue key="start">Earliest start first</enumerationValue>
                        <enumerationValue key="span">Longest first</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Interaction">
                <property key="tooltipText" type="textTemplate" required="false" dataSource="dataSource">
                    <caption>Tooltip text</caption>
                    <description>Replaces the tooltip of a range.</description>
                </property>
                <property key="onClick" type="action" dataSource="dataSource" required="false">
                    <caption>On click</caption>
                    <description>Runs with the clicked range's object.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Title">
                <property key="title" type="textTemplate" required="false">
                    <caption>Title</caption>
                    <description>Leave empty when the page already has a heading.</description>
                </property>
                <property key="subtitle" type="textTemplate" required="false">
                    <caption>Subtitle</caption>
                    <description />
                </property>
                <property key="titleAlign" type="enumeration" defaultValue="left">
                    <caption>Title position</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="left">Top left</enumerationValue>
                        <enumerationValue key="center">Top centre</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="emptyMessage" type="textTemplate" required="false">
                    <caption>No data message</caption>
                    <description />
                    <translations>
                        <translation lang="en_US">No data</translation>
                    </translations>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Shape and labels">
            <propertyGroup caption="Shape">
                <property key="rangeStyle" type="enumeration" defaultValue="bars">
                    <caption>Style</caption>
                    <description>Dumbbells draw a dot at each end, joined by a line.</description>
                    <enumerationValues>
                        <enumerationValue key="bars">Floating bars</enumerationValue>
                        <enumerationValue key="dumbbell">Dumbbells</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="orientation" type="enumeration" defaultValue="horizontal">
                    <caption>Direction</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="horizontal">Horizontal</enumerationValue>
                        <enumerationValue key="vertical">Vertical</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="barWidth" type="integer" defaultValue="60">
                    <caption>Bar width</caption>
                    <description>Percent of the space each row gets.</description>
                </property>
                <property key="cornerRadius" type="integer" defaultValue="4">
                    <caption>Corner radius</caption>
                    <description>In pixels.</description>
                </property>
                <property key="dotSize" type="integer" defaultValue="12">
                    <caption>Dot size</caption>
                    <description>Dumbbell end size, in pixels.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Labels">
                <property key="valueLabels" type="enumeration" defaultValue="off">
                    <caption>Value labels</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="off">Off</enumerationValue>
                        <enumerationValue key="ends">From and to, at the ends</enumerationValue>
                        <enumerationValue key="span">Length of the range</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="labelStyle" type="enumeration" defaultValue="plain">
                    <caption>Label style</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="plain">Plain</enumerationValue>
                        <enumerationValue key="darkPill">Dark pill</enumerationValue>
                        <enumerationValue key="lightPill">Light pill</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Axes">
                <property key="showCategoryAxis" type="boolean" defaultValue="true">
                    <caption>Show category axis</caption>
                    <description />
                </property>
                <property key="showValueAxis" type="boolean" defaultValue="true">
                    <caption>Show value axis</caption>
                    <description />
                </property>
                <property key="valueAxisTitle" type="textTemplate" required="false">
                    <caption>Value axis title</caption>
                    <description />
                </property>
                <property key="dateFormat" type="string" required="false">
                    <caption>Date format</caption>
                    <description>For a time axis, an ECharts format such as {MMM} {d}. Empty picks one that fits the range.</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Number format">
                <property key="decimals" type="integer" defaultValue="-1">
                    <caption>Decimals</caption>
                    <description>-1 shows up to two decimals, only when needed.</description>
                </property>
                <property key="prefix" type="string" required="false">
                    <caption>Prefix</caption>
                    <description>For example $.</description>
                </property>
                <property key="suffix" type="string" required="false">
                    <caption>Suffix</caption>
                    <description>For example % or  kg.</description>
                </property>
                <property key="thousandsSeparator" type="boolean" defaultValue="true">
                    <caption>Thousands separator</caption>
                    <description />
                </property>
                <property key="compactNumbers" type="boolean" defaultValue="false">
                    <caption>Compact numbers</caption>
                    <description>1.2K instead of 1,200.</description>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Chart style">
            <propertyGroup caption="Theme">
                <property key="theme" type="enumeration" defaultValue="hyper">
                    <caption>Theme</caption>
                    <description>Hyper turns dark under the app's .dark-mode class, or wherever --hc-mode: dark is set.</description>
                    <enumerationValues>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperLight">Hyper light</enumerationValue>
                        <enumerationValue key="hyperDark">Hyper dark</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="palette" type="enumeration" defaultValue="theme">
                    <caption>Palette</caption>
                    <description>Theme colours come from the theme, or from --hc-color-1 to --hc-color-8 in your theme SCSS.</description>
                    <enumerationValues>
                        <enumerationValue key="theme">Theme colours</enumerationValue>
                        <enumerationValue key="hyper">Hyper</enumerationValue>
                        <enumerationValue key="hyperHighContrast">Hyper high-contrast</enumerationValue>
                        <enumerationValue key="monochrome">Monochrome</enumerationValue>
                        <enumerationValue key="custom">Custom</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="customPalette" type="string" required="false">
                    <caption>Custom colours</caption>
                    <description>Comma-separated, in order, for example #8038D0, #F87800, #0860F8.</description>
                </property>
                <property key="background" type="enumeration" defaultValue="transparent">
                    <caption>Background</caption>
                    <description>Transparent lets the chart sit on whatever container holds it.</description>
                    <enumerationValues>
                        <enumerationValue key="transparent">Transparent</enumerationValue>
                        <enumerationValue key="surface">Theme surface</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="figuresFont" type="enumeration" defaultValue="mono">
                    <caption>Figures font</caption>
                    <description>Font for numbers on labels and tooltips.</description>
                    <enumerationValues>
                        <enumerationValue key="mono">Monospaced</enumerationValue>
                        <enumerationValue key="text">Same as text</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Marks">
                <property key="glow" type="enumeration" defaultValue="soft">
                    <caption>Glow</caption>
                    <description>A soft coloured shadow under the bars.</description>
                    <enumerationValues>
                        <enumerationValue key="soft">Soft</enumerationValue>
                        <enumerationValue key="off">Off</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="gridlines" type="enumeration" defaultValue="vertical">
                    <caption>Gridlines</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="none">None</enumerationValue>
                        <enumerationValue key="vertical">Vertical</enumerationValue>
                        <enumerationValue key="horizontal">Horizontal</enumerationValue>
                        <enumerationValue key="both">Both</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="legend" type="enumeration" defaultValue="auto">
                    <caption>Legend</caption>
                    <description>Automatic shows it when Group by splits the ranges.</description>
                    <enumerationValues>
                        <enumerationValue key="auto">Automatic</enumerationValue>
                        <enumerationValue key="top">Top</enumerationValue>
                        <enumerationValue key="bottom">Bottom</enumerationValue>
                        <enumerationValue key="right">Right</enumerationValue>
                        <enumerationValue key="hidden">Hidden</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="tooltip" type="enumeration" defaultValue="card">
                    <caption>Tooltip</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="card">Card</enumerationValue>
                        <enumerationValue key="pill">Pill</enumerationValue>
                        <enumerationValue key="off">Off</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
            <propertyGroup caption="Size and motion">
                <property key="heightUnit" type="enumeration" defaultValue="pixels">
                    <caption>Height unit</caption>
                    <description />
                    <enumerationValues>
                        <enumerationValue key="pixels">Pixels</enumerationValue>
                        <enumerationValue key="percentageOfWidth">Percentage of width</enumerationValue>
                        <enumerationValue key="fill">Fill the container</enumerationValue>
                    </enumerationValues>
                </property>
                <property key="height" type="integer" defaultValue="240">
                    <caption>Height</caption>
                    <description />
                </property>
                <property key="animation" type="boolean" defaultValue="true">
                    <caption>Animation</caption>
                    <description />
                </property>
                <property key="animationDuration" type="integer" defaultValue="600">
                    <caption>Animation duration</caption>
                    <description>In milliseconds.</description>
                </property>
                <property key="renderer" type="enumeration" defaultValue="canvas">
                    <caption>Renderer</caption>
                    <description>Canvas is fastest for large data. SVG is sharper when printed.</description>
                    <enumerationValues>
                        <enumerationValue key="canvas">Canvas</enumerationValue>
                        <enumerationValue key="svg">SVG</enumerationValue>
                    </enumerationValues>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Advanced">
            <propertyGroup caption="Custom theme">
                <property key="themeJson" type="string" multiline="true" required="false">
                    <caption>Theme JSON</caption>
                    <description>Used when Theme is Custom. Build one at https://echarts.apache.org/en/theme-builder.html: 1. Import hyper-light.theme-builder.json from the styling guide (Help). 2. Adjust it. 3. Download the JSON version and paste it here.</description>
                </property>
                <property key="themeJsonExpression" type="expression" required="false">
                    <caption>Theme JSON (dynamic)</caption>
                    <description>A theme from an attribute or expression, merged over Theme JSON. Lets each customer or user have their own.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
            <propertyGroup caption="Option override">
                <property key="optionOverride" type="string" multiline="true" required="false">
                    <caption>Option override</caption>
                    <description>ECharts option JSON merged over everything else, last. Anything ECharts supports: https://echarts.apache.org/en/option.html</description>
                </property>
                <property key="optionOverrideExpression" type="expression" required="false">
                    <caption>Option override (dynamic)</caption>
                    <description>Merged after Option override.</description>
                    <returnType type="String" />
                </property>
            </propertyGroup>
        </propertyGroup>
    </properties>
</widget>
