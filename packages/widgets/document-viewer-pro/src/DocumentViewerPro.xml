                        <translation lang="en_US">No file to show.</translation>
                    </translations>
                </property>
                <property key="labelFallback" type="textTemplate" required="false">
                    <caption>Preview copy</caption>
                    <description>Shown above the preview file when the original can't be displayed.</description>
                    <translations>
                        <translation lang="en_US">Showing a PDF copy of this file.</translation>
                    </translations>
                </property>
                <property key="labelPassword" type="textTemplate" required="false">
                    <caption>Password prompt</caption>
